{"nodes": [{"id": "landing_page_index_html", "label": "POLARIS Landing Page", "file_type": "document", "source_file": "landing_page/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "landing_page_hero_pitch", "label": "AI Loan Sales, Governed by Code (Hero Pitch)", "file_type": "rationale", "source_file": "landing_page/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POLARIS replaces fragile LLM conversation loops with a deterministic FSM: the machine decides transitions, the LLM only generates language within a bounded stage."}, {"id": "landing_page_problem_section", "label": "Why Raw LLMs Fail in Regulated Workflows", "file_type": "rationale", "source_file": "landing_page/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw LLM loops can hallucinate, loop, skip mandatory legal steps, and exhaust quota unpredictably in regulated finance workflows."}, {"id": "landing_page_infinite_loops", "label": "Infinite Loops Problem", "file_type": "concept", "source_file": "landing_page/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "landing_page_nondeterministic_decisions", "label": "Non-Deterministic Decisions Problem", "file_type": "concept", "source_file": "landing_page/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "landing_page_stage_skipping", "label": "Stage Skipping Problem", "file_type": "concept", "source_file": "landing_page/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "landing_page_quota_exhaustion", "label": "Quota Exhaustion Problem", "file_type": "concept", "source_file": "landing_page/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "landing_page_fsm_solution", "label": "9-State FSM Solution", "file_type": "concept", "source_file": "landing_page/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "landing_page_underwriting_engine", "label": "Underwriting Engine (4 Rules, No LLM)", "file_type": "rationale", "source_file": "landing_page/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The most critical decision in a loan (approve/reject) is never left to an LLM; every rule is deterministic, explainable, and auditable."}, {"id": "landing_page_rule_credit_score_gate", "label": "Rule 1: Credit Score Gate (<700 rejects)", "file_type": "concept", "source_file": "landing_page/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "landing_page_rule_instant_approval", "label": "Rule 2: Instant Approval (within preapproved limit)", "file_type": "concept", "source_file": "landing_page/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "landing_page_rule_income_verification", "label": "Rule 3: Income Verification (salary slip, EMI<=50% salary)", "file_type": "concept", "source_file": "landing_page/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "landing_page_rule_hard_limit_reject", "label": "Rule 4: Hard Limit Reject (>2x limit)", "file_type": "concept", "source_file": "landing_page/index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "landing_page_anti_loop_layers", "label": "3 Anti-Loop Safeguard Layers (terminal lock, quota, dedupe hash)", "file_type": "rationale